# ChatterMate environment for an OpenShip project.
#
# Paste this into: Project -> Environment -> "Edit as text" -> Apply changes.
# Project-level variables reach every service in the stack, which is what this
# app needs: the backend and all three workers read the same configuration.
#
# Replace every <PLACEHOLDER>. Generate the three secrets with the commands
# shown next to them; the backend refuses to start in production while any of
# them is missing or still at the value published in the repo.
#
# Domain layout used below (two hostnames, both on OpenShip's edge):
#   https://app.example.com  -> frontend service, container port 8001
#   https://api.example.com  -> backend service,  container port 8000
# The separate API hostname is deliberate: the frontend's nginx only proxies
# /api/, so Socket.IO needs its own address. Cookies are issued Secure +
# SameSite=None over https, so the split works without code changes.

# ---------------------------------------------------------------- required ---

# openssl rand -hex 32
JWT_SECRET_KEY=<paste-openssl-rand-hex-32>
JWT_ALGORITHM=HS256

# openssl rand -hex 32
CONVERSATION_SECRET_KEY=<paste-openssl-rand-hex-32>

# python -c "import base64;from cryptography.fernet import Fernet;print(base64.b64encode(Fernet.generate_key()).decode())"
ENCRYPTION_KEY=<paste-fernet-key>

# Matches the db service in docker-compose.openship.yml.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/chattermate

# production turns on the secret checks above; development skips them.
ENVIRONMENT=production

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com
# JSON array, not a comma list.
CORS_ORIGINS=["https://app.example.com"]

# ---------------------------------------------------------------- frontend ---
# Read by the frontend entrypoint at container start; no rebuild needed.

VITE_API_URL=https://api.example.com/api/v1
VITE_WS_URL=https://api.example.com
VITE_WIDGET_URL=https://api.example.com
NODE_ENV=production
HOST=0.0.0.0

# ---------------------------------------------------------------- optional ---
# Left empty, these features are simply off. Fill in only what you use.
# The full key list with descriptions lives in backend/.env.

S3_FILE_STORAGE=false
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_PRESIGN_EXPIRY_SECONDS=3600

# FIREBASE_CREDENTIALS is a *file path*, not a JSON blob. Without a mounted
# file the backend logs a warning and uses a demo certificate, so web push
# notifications do not work. Everything else runs normally.
# FIREBASE_CREDENTIALS=/app/config/firebase-config.json

# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_FIREBASE_VAPID_KEY=

# PASSWORD_LOGIN_ENABLED=true
# SIGNUP_ALLOWED_EMAILS=

# GOOGLE_SSO_CLIENT_ID=
# GOOGLE_SSO_CLIENT_SECRET=
# MICROSOFT_SSO_CLIENT_ID=
# MICROSOFT_SSO_CLIENT_SECRET=
# MICROSOFT_SSO_TENANT=common

# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# PIPEDRIVE_CLIENT_ID=
# PIPEDRIVE_CLIENT_SECRET=
